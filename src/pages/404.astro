---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 — Not Found | Banks in India"
	description="The page you were looking for could not be found."
>
	<main id="main-content">
		<header>
			<h1 class="italic">404 — Not Found</h1>
			<p>This route returned no matching record.</p>
		</header>

		<section aria-label="Suggestions">
			<h2>[Try instead]</h2>
			<ul>
				<li><a href="/">Banks in India</a> — the full directory</li>
				<li><a href="/ifsc-search">IFSC Search</a> — look up a specific branch code</li>
			</ul>
		</section>
	</main>
</Layout>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
