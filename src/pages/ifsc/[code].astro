---
import Layout from '../../layouts/Layout.astro';
import { getBranch, getBankMeta, getSiblings, isValidIfsc } from '../../lib/ifsc';

const rawParam = Astro.params.code || '';
const code = rawParam.trim().toUpperCase();

// Redirect any non-canonical casing to the uppercase permalink.
if (rawParam !== code) {
	return Astro.redirect(`/ifsc/${code}`, 301);
}

const branch = isValidIfsc(code) ? await getBranch(code) : undefined;

if (!branch) {
	Astro.response.status = 404;
}

const prefix = code.slice(0, 4);
const meta = branch ? getBankMeta(prefix) : undefined;
const siblings = branch ? await getSiblings(code, 12) : [];

const city = branch ? [branch.city, branch.district].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(', ') : '';
const phone = branch && branch.contact && branch.contact !== '0' ? branch.contact : '';
const networks = branch
	? [branch.neft && 'NEFT', branch.rtgs && 'RTGS', branch.imps && 'IMPS', branch.upi && 'UPI'].filter(Boolean).join(', ')
	: '';

const pageTitle = branch
	? `${branch.ifsc} — ${branch.bank}, ${branch.branch} | Banks in India`
	: `${code || 'IFSC'} not found | Banks in India`;

const pageDescription = branch
	? `IFSC code ${branch.ifsc} belongs to ${branch.bank}, ${branch.branch} branch${
			branch.city ? ` in ${branch.city}, ${branch.state}` : ''
	  }. Full branch address, MICR routing and contact details.`
	: `No branch matches the IFSC code ${code}. Search the full directory of Indian bank IFSC codes.`;

const structuredData = branch
	? {
			'@context': 'https://schema.org',
			'@type': 'BankOrCreditUnion',
			name: branch.bank,
			branchOf: meta ? { '@type': 'BankOrCreditUnion', name: meta.name } : undefined,
			identifier: branch.ifsc,
			telephone: phone || undefined,
			url: meta?.website || undefined,
			address: {
				'@type': 'PostalAddress',
				streetAddress: branch.address || undefined,
				addressLocality: branch.city || branch.centre || undefined,
				addressRegion: branch.state || undefined,
				addressCountry: 'IN',
			},
	  }
	: null;
---

<Layout title={pageTitle} description={pageDescription}>
	<main id="main-content">
		{branch ? (
			<>
				<header>
					<h1 class="italic">{branch.ifsc}</h1>
					<p>{branch.bank} — {branch.branch}{branch.city ? `, ${branch.city}` : ''}</p>
				</header>

				<section aria-label="Branch details">
					<h2>[Branch]</h2>
					<dl class="ifsc-detail">
						<div class="ifsc-detail__row">
							<dt>Bank</dt>
							<dd class="ifsc-detail__bank">
								{meta?.icon && (
									<img src={meta.icon} alt={`${branch.bank} logo`} width="24" height="24" loading="lazy" />
								)}
								<span>{branch.bank}</span>
							</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>Branch</dt>
							<dd>{branch.branch}</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>IFSC</dt>
							<dd>{branch.ifsc}</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>MICR</dt>
							<dd>{branch.micr || 'N/A'}</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>Address</dt>
							<dd>{branch.address || 'N/A'}</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>City</dt>
							<dd>{city || 'N/A'}</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>State</dt>
							<dd>{branch.state || 'N/A'}</dd>
						</div>
						<div class="ifsc-detail__row">
							<dt>Networks</dt>
							<dd>{networks || 'None'}</dd>
						</div>
						{branch.swift && (
							<div class="ifsc-detail__row">
								<dt>SWIFT</dt>
								<dd>{branch.swift}</dd>
							</div>
						)}
						{phone && (
							<div class="ifsc-detail__row">
								<dt>Phone</dt>
								<dd>{phone}</dd>
							</div>
						)}
						{meta?.website && (
							<div class="ifsc-detail__row">
								<dt>Website</dt>
								<dd><a href={meta.website} target="_blank" rel="noopener noreferrer">{meta.website}</a></dd>
							</div>
						)}
					</dl>
				</section>

				{siblings.length > 0 && (
					<section aria-label="Other branches in the same city">
						<h2>[More {branch.bank} branches in {branch.city}]</h2>
						<ul class="ifsc-siblings">
							{siblings.map((b) => (
								<li>
									<a href={`/ifsc/${b.ifsc}`}>{b.ifsc}</a>
									<span class="ifsc-siblings__branch"> — {b.branch}</span>
								</li>
							))}
						</ul>
					</section>
				)}

				<section aria-label="Search">
					<h2>[Lookup another]</h2>
					<ul>
						<li><a href="/ifsc-search">IFSC Search</a></li>
						<li><a href="/misc/neft-ifscs">All NEFT branches</a></li>
					</ul>
				</section>

				<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
			</>
		) : (
			<>
				<header>
					<h1 class="italic">IFSC not found</h1>
					<p>No branch matches <code>{code}</code>.</p>
				</header>
				<section aria-label="Suggestions">
					<h2>[Try instead]</h2>
					<ul>
						<li><a href="/ifsc-search">IFSC Search</a> — look up a valid branch code</li>
						<li><a href="/">Banks in India</a> — the full directory</li>
					</ul>
				</section>
			</>
		)}
	</main>
</Layout>

<style>
	.ifsc-detail {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(4.5rem, 24%) minmax(0, 1fr);
		column-gap: var(--gap);
		row-gap: var(--gap);
		align-items: baseline;
	}

	.ifsc-detail__row {
		display: contents;
	}

	.ifsc-detail dt {
		margin: 0;
		color: var(--content-secondary-alt);
		border-bottom: 1px dotted var(--border-inked);
	}

	.ifsc-detail dd {
		margin: 0;
		min-width: 0;
		word-break: break-word;
		border-bottom: 1px dotted var(--border-inked);
	}

	.ifsc-detail__bank {
		display: flex;
		align-items: center;
		gap: var(--gap);
	}

	.ifsc-siblings,
	section ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.ifsc-siblings__branch {
		color: var(--content-secondary-alt);
	}
</style>
