---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const { 
	title, 
	noindex = false,
	description = "Comprehensive directory of all active Indian banks with IFSC codes, logos, and official websites. Includes public sector, private sector, small finance, payment banks, regional rural banks, and foreign banks." 
} = Astro.props;

/* One URL per path: ignore querystrings (e.g. ?q=) for canonical to avoid duplicate indexing. */
const pathNorm = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalHref =
	pathNorm === '/' ? 'https://banksin.in/' : `https://banksin.in${pathNorm}`;

const isHome = pathNorm === '/';

const structuredData = isHome
	? {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'Banks in India',
			url: 'https://banksin.in/',
			description,
			inLanguage: 'en-IN',
			author: {
				'@type': 'Person',
				name: 'Abhimanyu Rana',
				url: 'https://planetabhi.com/',
			},
			publisher: {
				'@type': 'Organization',
				name: 'Banks in India',
				url: 'https://banksin.in/',
			},
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: 'https://banksin.in/ifsc-search?q={search_term_string}',
				},
				'query-input': 'required name=search_term_string',
			},
	  }
	: {
			'@context': 'https://schema.org',
			'@type': 'WebPage',
			name: title,
			url: canonicalHref,
			description,
			inLanguage: 'en-IN',
			isPartOf: {
				'@type': 'WebSite',
				name: 'Banks in India',
				url: 'https://banksin.in/',
			},
			author: {
				'@type': 'Person',
				name: 'Abhimanyu Rana',
				url: 'https://planetabhi.com/',
			},
			publisher: {
				'@type': 'Organization',
				name: 'Banks in India',
				url: 'https://banksin.in/',
			},
	  };

const hasRightSidebar = Astro.slots.has('sidebar-right');
---

<!doctype html>
<html lang="en" data-new-ui-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="indian banks, ifsc codes, bank directory, banking india, rbi banks, private banks, public sector banks, payment banks, small finance banks, regional rural banks, foreign banks, neft, rtgs, npci" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalHref} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Banks in India" />
		<meta property="og:locale" content="en_IN" />
		<meta property="og:image" content="https://banksin.in/og-image.png" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalHref} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://banksin.in/og-image.png" />
		<meta name="twitter:creator" content="@planetabhi" />
		
		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		
		<!-- Theme Color -->
		<meta name="theme-color" content="#ff69b4" />
		
		<!-- Performance: Font Preloading -->
		<link rel="preload" href="/fonts/Mono-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Mono-Italic.woff2" as="font" type="font/woff2" crossorigin />
		
		<!-- Performance: DNS Prefetch -->
		<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
		<link rel="dns-prefetch" href="https://data.jsdelivr.com" />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		
		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<div class:list={['layout-wrapper', { 'layout-wrapper--with-rhs': hasRightSidebar }]}>
			<aside class="sidebar" id="main-nav">
				<nav aria-label="Main Navigation">
					<ul>
						{[
							{ label: 'Banks in India', href: '/' },
							{ label: 'IFSC Search', href: '/ifsc-search' },
							{ label: 'IFSC Datasets', href: '/ifsc-datasets' }
						].map(item => {
							// Astro.url.pathname can sometimes be with or without a trailing slash
							const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
							const basePath = item.href.replace(/\/$/, '') || '/';
							const isActive = currentPath === basePath;
							
							return (
								<li>
									<a 
										href={item.href} 
										aria-current={isActive ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							);
						})}
					</ul>
				</nav>
				
				<footer>
					<p><a href="https://makeforindia.com/" target="_blank" rel="noopener noreferrer">Make for India</a> &middot; <a href="https://x.com/planetabhi" target="_blank" rel="noopener noreferrer">@planetabhi</a></p>
				</footer>
			</aside>
			<div class="content-wrapper">
				<slot />
			</div>
			{hasRightSidebar && (
				<aside class="sidebar-right">
					<slot name="sidebar-right" />
				</aside>
			)}
		</div>
		<script>
			// Global click-to-copy for IFSC/code cells (.copy-code) rendered
			// across the bank, listing and lazy tables.
			document.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement)?.closest('.copy-code') as HTMLElement | null;
				if (!btn) return;
				const text = btn.dataset.copy || btn.textContent || '';
				if (!text || !navigator.clipboard) return;
				navigator.clipboard.writeText(text).then(
					() => {
						btn.dataset.copied = 'true';
						setTimeout(() => btn.removeAttribute('data-copied'), 1200);
					},
					() => {}
				);
			});
		</script>
	</body>
</html>

