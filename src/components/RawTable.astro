---
interface Props<T extends Record<string, string | number>> {
	data: T[];
}

const { data } = Astro.props;
const headers = data.length > 0 ? Object.keys(data[0]) : [];
---

<div class="table-container">
<table class="listing-table">
  <thead>
    <tr>
      {headers.map(header => (
        <th scope="col">{header}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {data.map((row: {[key: string]: any}) => (
      <tr>
        {headers.map(header => (
          <td>
            {header.includes('IFSC') && row[header] ? (
              <button type="button" class="copy-code" data-copy={String(row[header])} title="Copy">{row[header]}</button>
            ) : (
              row[header]
            )}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</table>
</div>
