---
import banksDataJSON from '../datasets/core/banksData.json';

const uniqueBanks = Array.from(
    banksDataJSON.banks.flatMap((group: any) => group.content).reduce((map: any, bank: any) => {
        if (!map.has(bank.ifsc)) {
            map.set(bank.ifsc, bank);
        }
        return map;
    }, new Map()).values()
);

const iconMap = uniqueBanks.reduce((acc: any, bank: any) => {
    acc[bank.ifsc] = bank.icon;
    return acc;
}, {});
---

<div class="ifsc-search">
    <section class="ifsc-search__panel" aria-labelledby="ifsc-search-heading">
        <h2 id="ifsc-search-heading" class="ifsc-search__heading">IFSC lookup</h2>
        <form id="ifsc-form" class="ifsc-search__form" autocomplete="off">
            <div class="ifsc-search__field">
                <label class="ifsc-search__label" for="ifsc-input">Code</label>
                <div class="ifsc-search__input-wrap">
                    <input
                        class="ifsc-search__input"
                        type="text"
                        id="ifsc-input"
                        name="ifsc"
                        placeholder="HDFC0000001"
                        required
                        pattern="^[A-Z]{4}0[A-Z0-9]{6}$"
                        title="Enter a valid 11-character IFSC code"
                        inputmode="text"
                        spellcheck="false"
                    />
                    <button
                        type="button"
                        id="ifsc-clear"
                        class="ifsc-search__clear"
                        aria-label="Clear input"
                        hidden
                    >&#215;</button>
                </div>
            </div>
            <div class="ifsc-search__actions">
                <button type="submit" class="ifsc-search__submit">Search</button>
            </div>
        </form>
        <div id="recent-wrap" class="ifsc-search__recent t-resize" hidden>
            <div class="ifsc-search__recent-inner">
                <span class="ifsc-search__recent-label" id="recent-label">Recent</span>
                <ul id="recent-searches" class="ifsc-search__chips" aria-labelledby="recent-label"></ul>
            </div>
        </div>
    </section>

    <section class="ifsc-search__panel ifsc-search__panel--out t-panel-slide" id="ifsc-results-panel" aria-label="Search results" hidden>
        <p id="loading" class="ifsc-search__status t-shimmer" data-text="Searching…" hidden>Searching…</p>
        <div id="error-message" class="ifsc-search__error" role="alert" hidden></div>

        <script id="icon-map" type="application/json" set:html={JSON.stringify(iconMap)}></script>

        <dl id="result-card" class="ifsc-search__dl ifsc-search__dl--reveal" hidden>
            <div class="ifsc-search__row">
                <dt class="ifsc-search__dt">Bank</dt>
                <dd class="ifsc-search__dd ifsc-search__dd--bank">
                    <img id="res-icon" class="ifsc-search__logo" src="" alt="" width="24" height="24" hidden />
                    <span id="res-bank"></span>
                </dd>
            </div>
            <div class="ifsc-search__row">
                <dt class="ifsc-search__dt">Branch</dt>
                <dd class="ifsc-search__dd" id="res-branch"></dd>
            </div>
            <div class="ifsc-search__row">
                <dt class="ifsc-search__dt">Address</dt>
                <dd class="ifsc-search__dd" id="res-address"></dd>
            </div>
            <div class="ifsc-search__row">
                <dt class="ifsc-search__dt">Location</dt>
                <dd class="ifsc-search__dd">
                    <span id="res-city"></span><span class="ifsc-search__sep">, </span><span id="res-state"></span>
                </dd>
            </div>
            <div class="ifsc-search__row">
                <dt class="ifsc-search__dt">MICR</dt>
                <dd class="ifsc-search__dd" id="res-micr"></dd>
            </div>
            <div class="ifsc-search__row">
                <dt class="ifsc-search__dt">Networks</dt>
                <dd class="ifsc-search__dd" id="res-supported"></dd>
            </div>
            <div class="ifsc-search__row ifsc-search__row--final">
                <dt class="ifsc-search__dt">Copy</dt>
                <dd class="ifsc-search__dd ifsc-search__dd--action">
                    <button type="button" id="copy-btn" class="ifsc-search__copy t-text-swap">Copy details</button>
                </dd>
            </div>
        </dl>
    </section>
</div>

<script>
    const form = document.getElementById('ifsc-form') as HTMLFormElement | null;
    const input = document.getElementById('ifsc-input') as HTMLInputElement | null;
    const loading = document.getElementById('loading');
    const errorMessage = document.getElementById('error-message');
    const resultCard = document.getElementById('result-card');
    const resultsPanel = document.getElementById('ifsc-results-panel');
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;
    const recentWrap = document.getElementById('recent-wrap');
    const locationSep = document.querySelector('.ifsc-search__sep') as HTMLElement | null;
    const recentSearchesContainer = document.getElementById('recent-searches');
    const resIcon = document.getElementById('res-icon') as HTMLImageElement | null;
    const clearBtn = document.getElementById('ifsc-clear') as HTMLButtonElement | null;

    let currentData: any = null;
    let fetchController: AbortController | null = null;
    let iconMapCache: Record<string, string> | null = null;

    function revealResultsPanel() {
        if (!resultsPanel || resultsPanel.dataset.open === 'true') return;
        requestAnimationFrame(() => {
            resultsPanel!.dataset.open = 'true';
        });
    }

    function revealResultCard() {
        if (!resultCard) return;
        resultCard.hidden = false;
        requestAnimationFrame(() => {
            resultCard!.dataset.revealed = 'true';
        });
    }

    function resetResultCard() {
        if (!resultCard) return;
        resultCard.hidden = true;
        delete resultCard.dataset.revealed;
    }

    function showError(message: string) {
        if (!errorMessage || !input) return;
        errorMessage.textContent = message;
        errorMessage.hidden = false;
        errorMessage.classList.remove('is-error');
        void errorMessage.offsetWidth;
        errorMessage.classList.add('is-error');

        input.classList.remove('is-shaking');
        void input.offsetWidth;
        input.classList.add('is-shaking');
    }

    function clearError() {
        if (!errorMessage || !input) return;
        errorMessage.classList.remove('is-error');
        errorMessage.hidden = true;
        errorMessage.textContent = '';
        input.classList.remove('is-shaking');
    }

    function swapButtonText(btn: HTMLButtonElement, next: string) {
        const dur = parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--text-swap-dur')
        ) || 150;
        btn.classList.add('is-exit');
        setTimeout(() => {
            btn.textContent = next;
            btn.classList.remove('is-exit');
            btn.classList.add('is-enter-start');
            void btn.offsetHeight;
            btn.classList.remove('is-enter-start');
        }, dur);
        return dur;
    }

    function getIconMap(): Record<string, string> {
        if (iconMapCache) return iconMapCache;
        try {
            iconMapCache = JSON.parse(document.getElementById('icon-map')?.textContent || '{}') as Record<string, string>;
        } catch {
            iconMapCache = {};
        }
        return iconMapCache;
    }

    function renderRecent() {
        if (!recentSearchesContainer || !recentWrap) return;
        let recent: string[] = [];
        try {
            const parsed = JSON.parse(localStorage.getItem('recent_ifsc') || '[]');
            recent = Array.isArray(parsed) ? parsed.filter((item: any) => typeof item === 'string') : [];
        } catch (e) {
            /* ignore corrupted history */
        }

        recentSearchesContainer.textContent = '';
        if (recent.length === 0) {
            recentWrap.style.height = '0px';
            recentWrap.hidden = true;
            return;
        }

        recent.forEach((item) => {
            const a = document.createElement('a');
            a.setAttribute('href', `?q=${encodeURIComponent(item)}`);
            a.className = 'ifsc-search__chip';
            a.textContent = item;
            a.addEventListener('click', (e) => {
                e.preventDefault();
                if (input) input.value = item;
                searchIFSC(item);
            });
            const li = document.createElement('li');
            li.appendChild(a);
            recentSearchesContainer.appendChild(li);
        });

        recentWrap.hidden = false;
        requestAnimationFrame(() => {
            if (recentWrap) recentWrap.style.height = `${recentWrap.scrollHeight}px`;
        });
    }

    function saveRecent(ifsc: string) {
        try {
            let recent: string[] = [];
            const parsed = JSON.parse(localStorage.getItem('recent_ifsc') || '[]');
            recent = Array.isArray(parsed) ? parsed.filter((item: any) => typeof item === 'string') : [];
            recent = [ifsc, ...recent.filter((i: string) => i !== ifsc)].slice(0, 5);
            localStorage.setItem('recent_ifsc', JSON.stringify(recent));
        } catch (e) {
            /* privacy mode limits localStorage */
        }
        renderRecent();
    }

    async function searchIFSC(ifsc: string) {
        if (
            !form ||
            !input ||
            !loading ||
            !errorMessage ||
            !resultCard ||
            !resultsPanel ||
            !resIcon
        ) {
            return;
        }
        if (!ifsc.match(/^[A-Z]{4}0[A-Z0-9]{6}$/)) return;

        if (fetchController) fetchController.abort();
        fetchController = new AbortController();
        const { signal } = fetchController;

        resultsPanel.hidden = false;
        revealResultsPanel();
        loading.hidden = false;
        clearError();
        resetResultCard();
        currentData = null;
        if (locationSep) locationSep.hidden = false;

        const url = new URL(window.location.href);
        url.searchParams.set('q', ifsc);
        window.history.replaceState({}, '', url);

        try {
            const response = await fetch(`https://ifsc.razorpay.com/${ifsc}`, { signal });
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error(
                        "IFSC not found. Check the code — the 5th character is always zero (0)."
                    );
                }
                throw new Error('Something went wrong while fetching this branch.');
            }

            const data = await response.json();
            currentData = data;

            document.getElementById('res-bank')!.textContent = data.BANK;

            const iconMapData = getIconMap();
            const ifscPrefix = ifsc.substring(0, 4).toUpperCase();
            if (iconMapData[ifscPrefix]) {
                resIcon.src = iconMapData[ifscPrefix];
                resIcon.alt = `${data.BANK} logo`;
                resIcon.hidden = false;
            } else {
                resIcon.hidden = true;
                resIcon.removeAttribute('src');
                resIcon.alt = '';
            }

            document.getElementById('res-branch')!.textContent = data.BRANCH;
            document.getElementById('res-address')!.textContent = data.ADDRESS;
            const city = data.CITY || '';
            const state = data.STATE || '';
            document.getElementById('res-city')!.textContent = city;
            document.getElementById('res-state')!.textContent = state;
            if (locationSep) locationSep.hidden = !(city && state);
            document.getElementById('res-micr')!.textContent = data.MICR || 'N/A';

            const supported = [];
            if (data.NEFT) supported.push('NEFT');
            if (data.RTGS) supported.push('RTGS');
            if (data.IMPS) supported.push('IMPS');
            if (data.UPI) supported.push('UPI');
            document.getElementById('res-supported')!.textContent = supported.join(', ') || 'None';

            revealResultCard();
            saveRecent(ifsc);
        } catch (err) {
            if ((err as Error).name === 'AbortError') return;
            showError((err as Error).message);
        } finally {
            if (fetchController?.signal === signal && loading) {
                loading.hidden = true;
            }
        }
    }

    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!input) return;
        searchIFSC(input.value.trim().toUpperCase());
    });

    input?.addEventListener('input', () => {
        if (!input) return;
        clearError();
        let val = input.value.toUpperCase();
        if (val.length >= 5) {
            val = val.substring(0, 4) + '0' + val.substring(5);
        }
        val = val.replace(/[^A-Z0-9]/g, '');
        input.value = val;
        toggleClear();

        if (val.match(/^[A-Z]{4}0[A-Z0-9]{6}$/)) {
            searchIFSC(val);
        }
    });

    function toggleClear() {
        if (!clearBtn || !input) return;
        clearBtn.hidden = input.value.length === 0;
    }

    clearBtn?.addEventListener('click', () => {
        if (!input) return;
        input.value = '';
        clearError();
        toggleClear();
        input.focus();
    });

    // Press "/" anywhere (outside a field) to jump to the IFSC search.
    document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        const active = document.activeElement as HTMLElement | null;
        const tag = active?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || active?.isContentEditable) return;
        if (!input) return;
        e.preventDefault();
        input.focus();
        input.select();
    });

    copyBtn?.addEventListener('click', () => {
        if (!currentData || !copyBtn) return;
        const textToCopy = `Bank: ${currentData.BANK}\nBranch: ${currentData.BRANCH}\nIFSC: ${currentData.IFSC}\nAddress: ${currentData.ADDRESS}\nLocation: ${currentData.CITY}, ${currentData.STATE}`;

        navigator.clipboard.writeText(textToCopy).then(
            () => {
                const originalText = copyBtn.textContent || 'Copy details';
                const dur = swapButtonText(copyBtn, 'Copied');
                setTimeout(() => {
                    swapButtonText(copyBtn, originalText);
                }, dur + 2000);
            },
            () => {
                /* clipboard denied or unavailable (non-secure context, permissions) */
            }
        );
    });

    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q');
        if (q && input) {
            const u = q.toUpperCase();
            input.value = u;
            toggleClear();
            if (u.match(/^[A-Z]{4}0[A-Z0-9]{6}$/)) {
                searchIFSC(u);
            }
        }
        renderRecent();
    });
</script>

<style>
    .ifsc-search {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        min-width: 0;
    }

    .ifsc-search__panel {
        margin: 0;
        padding: 0;
        border: none;
    }

    .ifsc-search > .ifsc-search__panel:first-child {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        border-bottom: 1px dotted var(--border-inked);
    }

    .ifsc-search__panel--out {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        margin-top: 0;
        padding: 0;
        border: none;
    }

    .t-panel-slide {
        transform: translateY(var(--panel-translate-y));
        opacity: 0;
        filter: blur(var(--panel-blur));
        transition:
            transform var(--panel-close-dur) var(--panel-ease),
            opacity var(--panel-close-dur) var(--panel-ease),
            filter var(--panel-close-dur) var(--panel-ease);
        will-change: transform, opacity, filter;
    }

    .t-panel-slide[data-open="true"] {
        transform: translateY(0);
        opacity: 1;
        filter: blur(0);
        transition:
            transform var(--panel-open-dur) var(--panel-ease),
            opacity var(--panel-open-dur) var(--panel-ease),
            filter var(--panel-open-dur) var(--panel-ease);
    }

    @media (prefers-reduced-motion: reduce) {
        .t-panel-slide {
            transition: none !important;
        }
    }

    .ifsc-search__heading {
        margin: 0;
        padding: 0;
        font-family: var(--italic);
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-secondary-alt);
    }

    .ifsc-search__form {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        margin: 0;
        padding: 0;
    }

    .ifsc-search__field {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: var(--gap);
        margin: 0;
        padding: 0;
    }

    .ifsc-search__label {
        margin: 0;
        padding: 0;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-secondary-alt);
    }

    .ifsc-search__input-wrap {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 0;
    }

    .ifsc-search__input {
        box-sizing: border-box;
        width: 100%;
        margin: 0;
        padding: 0;
        padding-inline-end: 1.5rem;
        font: inherit;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-inked);
        background: var(--background);
        border: 1px dotted var(--border-inked);
        border-radius: 0;
        outline: none;
    }

    .ifsc-search__clear {
        position: absolute;
        inset-inline-end: 0;
        top: 0;
        bottom: 0;
        width: 1.5rem;
        margin: 0;
        padding: 0;
        font: inherit;
        font-size: var(--desktop-body);
        line-height: 1;
        color: var(--content-secondary-alt);
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .ifsc-search__clear:not([hidden]) {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ifsc-search__clear:hover,
    .ifsc-search__clear:focus-visible {
        outline: none;
        color: var(--selected);
    }

    .ifsc-search__input::placeholder {
        color: var(--content-secondary-alt);
        opacity: 0.85;
    }

    .ifsc-search__input:focus-visible {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent);
    }

    .ifsc-search__input.is-shaking {
        animation: ifsc-input-shake calc(var(--shake-dur-a) * 2 + var(--shake-dur-b) * 2) linear;
    }

    @keyframes ifsc-input-shake {
        0%      { transform: translateX(0); animation-timing-function: var(--shake-ease); }
        28.57%  { transform: translateX(var(--shake-distance)); animation-timing-function: var(--shake-ease); }
        57.14%  { transform: translateX(calc(var(--shake-distance) * -1)); animation-timing-function: var(--shake-ease); }
        78.57%  { transform: translateX(var(--shake-overshoot)); animation-timing-function: var(--shake-ease); }
        100%    { transform: translateX(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .ifsc-search__input.is-shaking {
            animation: none !important;
            transform: none !important;
        }
    }

    .ifsc-search__actions {
        display: flex;
        justify-content: flex-start;
        margin: 0;
        padding: 0;
    }

    .ifsc-search__submit {
        margin: 0;
        padding: 0;
        font: inherit;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-inked);
        background: var(--background);
        border: 1px dotted var(--border-inked);
        cursor: pointer;
    }

    .ifsc-search__submit:hover {
        background: var(--background-selected);
        border-color: var(--content-secondary-alt);
    }

    .ifsc-search__submit:focus-visible {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent);
    }

    .ifsc-search__recent {
        margin: 0;
        padding: 0;
        display: none;
        min-width: 0;
        border-top: 1px dotted var(--border-inked);
    }

    .ifsc-search__recent:not([hidden]) {
        display: block;
        overflow: hidden;
        height: 0;
        transition: height var(--resize-dur) var(--resize-ease);
        will-change: height;
    }

    @media (prefers-reduced-motion: reduce) {
        .ifsc-search__recent:not([hidden]) {
            transition: none !important;
        }
    }

    .ifsc-search__recent-inner {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        padding-top: var(--gap);
    }

    .ifsc-search__recent-label {
        margin: 0;
        padding: 0;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-secondary-alt);
    }

    .ifsc-search__chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--gap);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ifsc-search__chips li {
        margin: 0;
        padding: 0;
    }

    .ifsc-search__chip {
        display: inline-block;
        margin: 0;
        padding: 0;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        text-decoration: none;
        color: var(--accent);
        border: none;
        border-bottom: 1px dotted var(--border-inked);
        background: transparent;
    }

    .ifsc-search__chip:hover,
    .ifsc-search__chip:focus-visible {
        color: var(--selected);
        background: var(--background-selected);
    }

    .ifsc-search__status {
        margin: 0;
        padding: 0;
        font: inherit;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-secondary-alt);
    }

    .ifsc-search__status.t-shimmer {
        position: relative;
        color: var(--shimmer-base);
    }

    .ifsc-search__status.t-shimmer:not([hidden]) {
        display: inline-block;
    }

    .ifsc-search__status.t-shimmer::before {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(
            90deg,
            transparent 0%,
            transparent 40%,
            var(--shimmer-highlight) 50%,
            transparent 60%,
            transparent 100%
        );
        background-size: var(--shimmer-band) 100%;
        background-repeat: no-repeat;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        animation: ifsc-shimmer var(--shimmer-dur) var(--shimmer-ease) infinite;
    }

    @keyframes ifsc-shimmer {
        0%   { background-position: 100% 0; }
        100% { background-position: 0% 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .ifsc-search__status.t-shimmer::before {
            animation: none !important;
        }
    }

    .ifsc-search__error {
        margin: 0;
        padding: 0;
        font-size: var(--desktop-body);
        line-height: var(--lh-desktop-body);
        color: var(--content-inked);
        border: none;
        border-bottom: 1px dotted var(--border-inked);
        background: transparent;
        opacity: 0;
        transition: opacity var(--revert-dur) var(--ease-out);
    }

    .ifsc-search__error.is-error {
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .ifsc-search__error {
            transition: none !important;
        }
    }

    .ifsc-search__dl {
        margin: 0;
        padding: 0;
        align-items: baseline;
        display: none;
    }

    .ifsc-search__dl:not([hidden]) {
        display: grid;
        grid-template-columns: minmax(4.5rem, 32%) minmax(0, 1fr);
        column-gap: var(--gap);
        row-gap: var(--gap);
    }

    .ifsc-search__dl--reveal {
        --row-delay: 0ms;
    }

    .ifsc-search__dl--reveal .ifsc-search__dt,
    .ifsc-search__dl--reveal .ifsc-search__dd {
        opacity: 0;
        transform: translateY(var(--stagger-distance));
        filter: blur(var(--reveal-blur));
        transition:
            opacity var(--reveal-dur) var(--reveal-ease),
            transform var(--reveal-dur) var(--reveal-ease),
            filter var(--reveal-dur) var(--reveal-ease);
        transition-delay: var(--row-delay);
        will-change: transform, opacity, filter;
    }

    .ifsc-search__dl--reveal[data-revealed="true"] .ifsc-search__dt,
    .ifsc-search__dl--reveal[data-revealed="true"] .ifsc-search__dd {
        opacity: 1;
        transform: translateY(0);
