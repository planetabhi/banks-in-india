---
/*
 * Wraps a formatted number/string so each character can pop in
 * independently on page load (see `.t-digit-group` in global.css,
 * adapted from the transitions-dev "number pop-in" recipe).
 * Activation (`.is-animating`) is handled globally in Layout.astro.
 */
interface Props {
	value: string | number;
}

const { value } = Astro.props;
const chars = String(value).split('');
---

<span class="t-digit-group">
	{chars.map((ch, i) => (
		<span
			class="t-digit"
			data-stagger={i === chars.length - 2 ? '1' : i === chars.length - 1 ? '2' : undefined}
		>{ch}</span>
	))}
</span>
